  "private": true,
  "license": "MIT",
  "author": "Yuzuki Shiraishi",
  "description": "Official-compliant QQ Bot streaming & autonomous subagent bridge plugin for Google Antigravity (agy).",
  "homepage": "https://github.com/Shiratsuk1/agy-qqbot#readme",
